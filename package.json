  },
  "homepage": "https://github.com/varannaibence/npu-uj-neptunhoz#readme",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
