    "verify:prettier": "prettier -c \"src/**/*.js\" \"test/**/*.js\" \"tools/**/*.js\" selfcheck.js webpack.config.js",
    "verify:selfcheck": "node selfcheck.js",
    "test": "node selfcheck.js",
    "selfcheck": "node selfcheck.js",
    "dev": "node tools/dev-loader.js && webpack-cli --watch",
    "dev:loader": "node tools/dev-loader.js"
  },
  "repository": {
